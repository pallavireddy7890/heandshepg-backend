# Staging Environment Configuration - He&She PG
# Replace the placeholder values below with your actual configurations in Dokploy
DATABASE_URL=postgresql://postgres:your_password@stage-heandshepg-database-fjzmkz:5432/Stagedb
APP_ENV=stage
NODE_ENV=production

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=He&She PG

# Security Settings
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL
FRONTEND_URL=https://stage.heandshepg.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_from_number
